<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ContainerTypes>

<!-- GIRR band-scaled ship cargo. Theme: salvage / scrap / stolen industrial.
     Assigned per encounter threat band (see ENCOUNTER_THREAT_MAP.md):
       Easy   = probes / low ships (threat < 0.05)
       Medium = miners / haulers / merchants (threat 0.09-0.14)
       Hard   = modified transport and up (threat >= 0.15, non-elite)
     Backbone ids only. Roaching value is materials+components; big credits are
     gated to Elite ships. First-cut, tune later. -->

<!-- GIRR Cargo Easy -->
    <ContainerType CountMin="2" CountMax="3">
      <Id><TypeId>ContainerTypeDefinition</TypeId><SubtypeId>GIRR Cargo Easy</SubtypeId></Id>
      <Items>
        <Item AmountMin="500" AmountMax="2000"><Frequency>6</Frequency><Id><TypeId>Ore</TypeId><SubtypeId>Scrap</SubtypeId></Id></Item>
        <Item AmountMin="500" AmountMax="2500"><Frequency>4</Frequency><Id><TypeId>Ore</TypeId><SubtypeId>Iron</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>4</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Construction</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="400"><Frequency>4</Frequency><Id><TypeId>Component</TypeId><SubtypeId>SteelPlate</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>InteriorPlate</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech2x</SubtypeId></Id></Item>
        <Item AmountMin="5000" AmountMax="25000"><Frequency>2</Frequency><Id><TypeId>PhysicalObject</TypeId><SubtypeId>SpaceCredit</SubtypeId></Id></Item>
      </Items>
    </ContainerType>

<!-- GIRR Cargo Medium -->
    <ContainerType CountMin="3" CountMax="4">
      <Id><TypeId>ContainerTypeDefinition</TypeId><SubtypeId>GIRR Cargo Medium</SubtypeId></Id>
      <Items>
        <Item AmountMin="1000" AmountMax="3000"><Frequency>4</Frequency><Id><TypeId>Ore</TypeId><SubtypeId>Scrap</SubtypeId></Id></Item>
        <Item AmountMin="500" AmountMax="2000"><Frequency>3</Frequency><Id><TypeId>Ingot</TypeId><SubtypeId>Iron</SubtypeId></Id></Item>
        <Item AmountMin="200" AmountMax="800"><Frequency>2</Frequency><Id><TypeId>Ingot</TypeId><SubtypeId>Nickel</SubtypeId></Id></Item>
        <Item AmountMin="200" AmountMax="800"><Frequency>4</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Construction</SubtypeId></Id></Item>
        <Item AmountMin="300" AmountMax="1000"><Frequency>4</Frequency><Id><TypeId>Component</TypeId><SubtypeId>SteelPlate</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="400"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>MetalGrid</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="300"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Motor</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="200"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Reactor</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="200"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Thrust</SubtypeId></Id></Item>
        <Item AmountMin="200" AmountMax="800"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech2x</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="400"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech4x</SubtypeId></Id></Item>
        <Item AmountMin="25" AmountMax="50"><Frequency>1</Frequency><Id><TypeId>Component</TypeId><SubtypeId>GraphineGrid</SubtypeId></Id></Item>
        <Item AmountMin="25000" AmountMax="100000"><Frequency>2</Frequency><Id><TypeId>PhysicalObject</TypeId><SubtypeId>SpaceCredit</SubtypeId></Id></Item>
      </Items>
    </ContainerType>

<!-- GIRR Cargo Hard -->
    <ContainerType CountMin="3" CountMax="5">
      <Id><TypeId>ContainerTypeDefinition</TypeId><SubtypeId>GIRR Cargo Hard</SubtypeId></Id>
      <Items>
        <Item AmountMin="1000" AmountMax="4000"><Frequency>3</Frequency><Id><TypeId>Ingot</TypeId><SubtypeId>Iron</SubtypeId></Id></Item>
        <Item AmountMin="300" AmountMax="1000"><Frequency>2</Frequency><Id><TypeId>Ingot</TypeId><SubtypeId>Cobalt</SubtypeId></Id></Item>
        <Item AmountMin="500" AmountMax="1500"><Frequency>4</Frequency><Id><TypeId>Component</TypeId><SubtypeId>SteelPlate</SubtypeId></Id></Item>
        <Item AmountMin="200" AmountMax="600"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>MetalGrid</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="400"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Reactor</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="400"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Thrust</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Superconductor</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>PowerCell</SubtypeId></Id></Item>
        <Item AmountMin="400" AmountMax="1200"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech2x</SubtypeId></Id></Item>
        <Item AmountMin="200" AmountMax="600"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech4x</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech8x</SubtypeId></Id></Item>
        <Item AmountMin="25" AmountMax="75"><Frequency>1</Frequency><Id><TypeId>Component</TypeId><SubtypeId>GraphineGrid</SubtypeId></Id></Item>
        <Item AmountMin="25" AmountMax="100"><Frequency>1</Frequency><Id><TypeId>Component</TypeId><SubtypeId>AdaptiveDynoCapacitor</SubtypeId></Id></Item>
        <Item AmountMin="100000" AmountMax="300000"><Frequency>2</Frequency><Id><TypeId>PhysicalObject</TypeId><SubtypeId>SpaceCredit</SubtypeId></Id></Item>
      </Items>
    </ContainerType>

  </ContainerTypes>
</Definitions>
