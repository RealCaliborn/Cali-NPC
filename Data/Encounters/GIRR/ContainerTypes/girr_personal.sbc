<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ContainerTypes>

<!-- GIRR Personal: lockers, locker rooms. Crew kit for a pirate outfit - tools,
     small arms + ammo, consumables, odd salvage. Backbone ids only. Assigned to
     GIRR "Lockers"/"Locker Room" blocks (currently unlooted). First-cut. -->
    <ContainerType CountMin="2" CountMax="4">
      <Id><TypeId>ContainerTypeDefinition</TypeId><SubtypeId>GIRR Personal</SubtypeId></Id>
      <Items>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>AngleGrinder2Item</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>HandDrill2Item</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>Welder2Item</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="1"><Frequency>2</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>AngleGrinder3Item</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>AutomaticRifleItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>SemiAutoPistolItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="1"><Frequency>2</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>FullAutoPistolItem</SubtypeId></Id></Item>
        <Item AmountMin="4" AmountMax="12"><Frequency>4</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>AutomaticRifleGun_Mag_20rd</SubtypeId></Id></Item>
        <Item AmountMin="4" AmountMax="12"><Frequency>4</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>SemiAutoPistolMagazine</SubtypeId></Id></Item>
        <Item AmountMin="3" AmountMax="8"><Frequency>3</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>NATO_5p56x45mm</SubtypeId></Id></Item>
        <Item AmountMin="2" AmountMax="6"><Frequency>4</Frequency><Id><TypeId>ConsumableItem</TypeId><SubtypeId>Medkit</SubtypeId></Id></Item>
        <Item AmountMin="2" AmountMax="6"><Frequency>4</Frequency><Id><TypeId>ConsumableItem</TypeId><SubtypeId>Powerkit</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="4"><Frequency>2</Frequency><Id><TypeId>ConsumableItem</TypeId><SubtypeId>ClangCola</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Construction</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="3"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Canvas</SubtypeId></Id></Item>
        <Item AmountMin="2500" AmountMax="15000"><Frequency>3</Frequency><Id><TypeId>PhysicalObject</TypeId><SubtypeId>SpaceCredit</SubtypeId></Id></Item>
      </Items>
    </ContainerType>

<!-- GIRR Armory: Weapon Rack / Armory blocks. Weapons + ammo ONLY (theme).
     No tools, consumables, components, or credits. Backbone ids. -->
    <ContainerType CountMin="2" CountMax="4">
      <Id><TypeId>ContainerTypeDefinition</TypeId><SubtypeId>GIRR Armory</SubtypeId></Id>
      <Items>
        <Item AmountMin="1" AmountMax="2"><Frequency>4</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>AutomaticRifleItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>RapidFireAutomaticRifleItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="1"><Frequency>2</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>PreciseAutomaticRifleItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>SemiAutoPistolItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>FullAutoPistolItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="1"><Frequency>1</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>ElitePistolItem</SubtypeId></Id></Item>
        <Item AmountMin="6" AmountMax="16"><Frequency>5</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>AutomaticRifleGun_Mag_20rd</SubtypeId></Id></Item>
        <Item AmountMin="6" AmountMax="16"><Frequency>4</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>NATO_5p56x45mm</SubtypeId></Id></Item>
        <Item AmountMin="4" AmountMax="12"><Frequency>4</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>RapidFireAutomaticRifleGun_Mag_50rd</SubtypeId></Id></Item>
        <Item AmountMin="4" AmountMax="12"><Frequency>4</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>SemiAutoPistolMagazine</SubtypeId></Id></Item>
        <Item AmountMin="4" AmountMax="12"><Frequency>3</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>FullAutoPistolMagazine</SubtypeId></Id></Item>
        <Item AmountMin="2" AmountMax="6"><Frequency>2</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>ElitePistolMagazine</SubtypeId></Id></Item>
        <Item AmountMin="2" AmountMax="6"><Frequency>2</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>PreciseAutomaticRifleGun_Mag_5rd</SubtypeId></Id></Item>
      </Items>
    </ContainerType>

  </ContainerTypes>
</Definitions>
