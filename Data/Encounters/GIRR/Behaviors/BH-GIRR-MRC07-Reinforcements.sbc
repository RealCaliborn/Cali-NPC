<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <!--
      MRC07 maintain-alive reinforcement behaviors.
      Each behavior carries:
        - an "Answer" trigger that replies to the boss's per-loop Check command
          with that loop's "Alive" command (keeps the boss from relaunching),
        - a single-fire "SpawnCall" chat (with GIRR audio) fired on spawn.
      Breaker1/Breaker2 = aggressive shield-breakers (Brawler-Close, short timings).
      Screen = defensive anti-missile Class B Probe (standoff near the boss).
      TG-Common-Jump is deliberately omitted so escorts stay on-station around
      MRC07. Mayday responder groups are included so escorts participate in wave
      liveness and receive the CloseWave failsafe.
    -->

    <!-- ================= BREAKER1: (NPC-GIRR) Captured Cruiser ================= -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-GIRR-MRC07-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:HorseFighter]
        [AutopilotData:AP-Common-Brawler-Close-B]
        [HorseFighterTimeEngaging:50]
        [HorseFighterTimeApproaching:12]
        [TargetData:TA-Common-Default-A]
        [OverrideTargetData:TA-Common-Default-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [UseStaticGuns:true]
        [MaxStaticWeaponRange:-1]
        [UseTurrets:true]
        [UseBarrageFire:true]
        [UseAmmoReplenish:true]
        [TriggerGroups:TG-Common-PvE-Hard]
        [Triggers:TR-Common-FireFixed]
        [TriggerGroups:TG-GIRR-Target-Sharing]
        [TriggerGroups:TG-GIRR-Reputation]
        [TriggerGroups:TG-PRTH-GIRR-Mayday-Responder]
        [TriggerGroups:TG-ECHO-GIRR-Mayday-Responder]
        [Triggers:TR-GIRR-MRC07-Answer-Breaker1]
        [Triggers:TR-GIRR-MRC07-SpawnCall-Breaker1]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-GIRR-MRC07-Answer-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:true]
        [Type:CommandReceived]
        [MinCooldownMs:0]
        [MaxCooldownMs:1]
        [StartsReady:true]
        [MaxActions:-1]
        [CommandReceiveCode:CO-GIRR-MRC07-Check-Breaker1]
        [Actions:AC-GIRR-MRC07-Answer-Breaker1]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-GIRR-MRC07-Answer-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]
        [BroadcastCommandProfiles:true]
        [CommandProfileIds:CO-GIRR-MRC07-Alive-Breaker1]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CO-GIRR-MRC07-Alive-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Command]
        [CommandCode:CO-GIRR-MRC07-Alive-Breaker1]
        [MatchSenderReceiverOwners:true]
        [IgnoreAntennaRequirement:true]
        [Radius:10000]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-GIRR-MRC07-SpawnCall-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:true]
        [Type:Timer]
        [MinCooldownMs:1500]
        [MaxCooldownMs:2500]
        [StartsReady:true]
        [MaxActions:1]
        [Actions:AC-GIRR-MRC07-SpawnCall-Breaker1]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-GIRR-MRC07-SpawnCall-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]
        [UseChatBroadcast:true]
        [ChatData:CH-GIRR-MRC07-SpawnCall-Breaker1]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CH-GIRR-MRC07-SpawnCall-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Chat]
        [UseChat:true]
        [StartsReady:true]
        [MaxChats:1]
        [BroadcastRandomly:false]
        [Author:GIRR Captured Cruiser]
        [Color:Red]
        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:10000]
        [ChatMessages:Cruiser answering the call — moving in to break your shields.]
        [ChatAudio:girr-ping-01]
        [BroadcastChatType:Chat]

      </Description>
    </EntityComponent>

