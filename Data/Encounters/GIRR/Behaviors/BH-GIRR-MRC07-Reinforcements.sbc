        [BroadcastRandomly:false]
        [Author:GIRR Modified Transport]
        [Color:Red]
        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:10000]
        [ChatMessages:Transport inbound — railguns hot, closing to attack.]
        [ChatAudio:girr-ping-02]
        [BroadcastChatType:Chat]

      </Description>
    </EntityComponent>

    <!-- ================= SCREEN: (NPC-GIRR) Class B Probe ================= -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-GIRR-MRC07-Screen</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:Hunter]
        [AutopilotData:AP-Common-Default-A]
        [SecondaryAutopilotData:AP-Common-Standoff-1500-2000-B]
        [TargetData:TA-Common-8000-A]
        [OverrideTargetData:TA-Common-Default-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [UseStaticGuns:true]
        [MaxStaticWeaponRange:4000]
        [UseTurrets:true]
        [UseBarrageFire:true]
        [UseAmmoReplenish:true]
        [TriggerGroups:TG-Common-PvE-Default]
        [Triggers:TR-Common-FireFixed]
        [TriggerGroups:TG-GIRR-Target-Sharing]
        [TriggerGroups:TG-GIRR-Reputation]
        [TriggerGroups:TG-PRTH-GIRR-Mayday-Responder]
        [TriggerGroups:TG-ECHO-GIRR-Mayday-Responder]
        [Triggers:TR-GIRR-MRC07-Answer-Screen]
        [Triggers:TR-GIRR-MRC07-SpawnCall-Screen]

      </Description>
    </EntityComponent>

