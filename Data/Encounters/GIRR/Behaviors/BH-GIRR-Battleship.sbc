<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <!--
      (NPC-GIRR) Modified Battleship — standalone called-in reinforcement.
      This is the RESPONDER side: the Battleship answers the caller's per-poll
      Check command with an Alive command (which resets the caller's relaunch
      timer, so it is never re-called while this one lives), and fires a single
      SpawnCall chat on arrival. Call-once: the caller's spawner is MaxSpawns:1,
      so once this capital dies it is not respawned. Caller = TG-GIRR-Battleship-Call
      (carried by BH-GIRR-CruiserSpawn). HorseFighter on Standoff — a capital holds
      range with its 500mm turrets / Guardian beams / Fixed T3 batteries.
    -->

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-GIRR-Battleship</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:HorseFighter]
        [AutopilotData:AP-Common-Default-A]
        [SecondaryAutopilotData:AP-Common-Standoff-1500-2250-B]
        [HorseFighterTimeEngaging:55]
        [HorseFighterTimeApproaching:15]
        [TargetData:TA-Common-8000-A]
        [OverrideTargetData:TA-Common-Default-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [UseStaticGuns:true]
        [MaxStaticWeaponRange:-1]
        [UseTurrets:true]
        [UseBarrageFire:true]
        [UseAmmoReplenish:true]
        [TriggerGroups:TG-Common-PvE-Hard]
        [Triggers:TR-Common-FireFixed]
        [TriggerGroups:TG-GIRR-Target-Sharing]
        [TriggerGroups:TG-GIRR-Reputation]
        [TriggerGroups:TG-PRTH-GIRR-Mayday-Responder]
        [TriggerGroups:TG-ECHO-GIRR-Mayday-Responder]
        [Triggers:TR-GIRR-Battleship-Answer]
        [Triggers:TR-GIRR-Battleship-SpawnCall]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-GIRR-Battleship-Answer</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:true]
        [Type:CommandReceived]
        [MinCooldownMs:0]
        [MaxCooldownMs:1]
        [StartsReady:true]
        [MaxActions:-1]
        [CommandReceiveCode:CO-GIRR-Battleship-Check]
        [Actions:AC-GIRR-Battleship-Answer]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-GIRR-Battleship-Answer</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]
        [BroadcastCommandProfiles:true]
        [CommandProfileIds:CO-GIRR-Battleship-Alive]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CO-GIRR-Battleship-Alive</SubtypeId>
      </Id>
      <Description>

        [RivalAI Command]
        [CommandCode:CO-GIRR-Battleship-Alive]
        [MatchSenderReceiverOwners:true]
        [IgnoreAntennaRequirement:true]
        [Radius:12000]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-GIRR-Battleship-SpawnCall</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:true]
        [Type:Timer]
        [MinCooldownMs:1500]
        [MaxCooldownMs:2500]
        [StartsReady:true]
        [MaxActions:1]
        [Actions:AC-GIRR-Battleship-SpawnCall]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-GIRR-Battleship-SpawnCall</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]
        [UseChatBroadcast:true]
        [ChatData:CH-GIRR-Battleship-SpawnCall]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CH-GIRR-Battleship-SpawnCall</SubtypeId>
      </Id>
      <Description>

        [RivalAI Chat]
        [UseChat:true]
        [StartsReady:true]
        [MaxChats:1]
        [BroadcastRandomly:false]
        [Author:GIRR Modified Battleship]
        [Color:Red]
        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:12000]
        [ChatMessages:Battleship answering the call — bringing the main batteries to bear.]
        [ChatAudio:girr-whoosh-03]
        [BroadcastChatType:Chat]

      </Description>
    </EntityComponent>

  </EntityComponents>
</Definitions>
