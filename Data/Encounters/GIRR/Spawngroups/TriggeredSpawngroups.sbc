        <!-- =========================================================
             Standalone GIRR reinforcement: Modified Battleship. Called
             ONCE (MaxSpawns:1 on SP-GIRR-Battleship-Launch) by a heavy
             GIRR Cruiser via TG-GIRR-Battleship-Call. Not respawned on death. -->

        <!-- (NPC-GIRR) Battleship Wing -->
        <SpawnGroup>
            <Id>
                <TypeId>SpawnGroupDefinition</TypeId>
