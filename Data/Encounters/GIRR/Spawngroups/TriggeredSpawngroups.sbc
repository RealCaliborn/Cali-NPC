<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <SpawnGroups>

        <!-- (NPC-GIRR) CruiserSpawn Hauler -->
        <SpawnGroup>
            <Id>
                <TypeId>SpawnGroupDefinition</TypeId>
                <SubtypeId>(NPC-GIRR) CruiserSpawn Hauler</SubtypeId>
            </Id>
            <Description>

            [Modular Encounters SpawnGroup]

            [DisableDampeners:false]

            [SpaceCargoShip:false]
            [LunarCargoShip:false]
            [SpaceRandomEncounter:false]
            [AtmosphericCargoShip:false]
            [PlanetaryInstallation:false]
            [RivalAiSpawn:true]

            [FactionOwner:GIRR]
            [ReplenishSystems:true]
            [AddDefenseShieldBlocks:true]

            [UseRivalAi:true]
            [RivalAiReplaceRemoteControl:true]
            [RotateFirstCockpitToForward:true]
            [ManipulationProfiles:MES-Manipulation-PropulsionGIRR]

            [AssignContainerTypesToAllCargo:GIRR Cargo Medium]

            [UseContainerTypeAssignment:true]
            [ContainerTypeAssignmentReference:Large Cargo Container|GIRR Cargo Medium,Small Cargo Container|GIRR Cargo Medium,NPC_Container|GIRR Cargo Medium,Modified Cargo Hauler|GIRR Cargo Medium,Enclosed Passage Cargo Access 3|GIRR Cargo Medium,Lockers|GIRR Personal,Lockers 2|GIRR Personal,Lockers 3|GIRR Personal,Lockers 4|GIRR Personal,Lockers 5|GIRR Personal,Locker Room|GIRR Personal,Weapon Rack|GIRR Armory,Weapon Rack 4|GIRR Armory,Weapon Rack 5|GIRR Armory,Armory|GIRR Armory,Armory 2|GIRR Armory,Armory Lockers|GIRR Armory,Armory Lockers 2|GIRR Armory,Reward Container|Cali Elite Reward]
            </Description>
            <IsPirate>true</IsPirate>
            <Frequency>1.0</Frequency>
            <Prefabs>
                <Prefab SubtypeId="(NPC-GIRR) Modified Hauler">
                    <Position>
                        <X>0.0</X>
                        <Y>0.0</Y>
                        <Z>0.0</Z>
                    </Position>
                    <Speed>25</Speed>
                    <Behaviour>BH-GIRR-Hauler</Behaviour>
                </Prefab>
            </Prefabs>
        </SpawnGroup>
        <!-- (NPC-GIRR) CruiserSpawn Hauler -->

