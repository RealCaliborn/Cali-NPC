        [RivalAI Action]
        [ResetCooldownTimeOfTriggers:true]
        [ResetTriggerCooldownNames:TR-GIRR-MRC07-Launch-Screen]

      </Description>
    </EntityComponent>

  </EntityComponents>
</Definitions>
