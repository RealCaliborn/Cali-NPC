      </Id>
      <Description>

        [RivalAI Action]
        [BroadcastCommandProfiles:true]
        [CommandProfileIds:CO-GIRR-MRC07-Check-Screen]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
