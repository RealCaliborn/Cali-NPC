        [ResetCooldownTimeOfTriggers:true]
        [ResetTriggerCooldownNames:TR-GIRR-MRC07-Launch-Breaker2]

      </Description>
    </EntityComponent>

    <!-- ================= SCREEN LOOP (Class B Probe) ================= -->

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-GIRR-MRC07-Launch-Screen</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:false]
        [Type:Timer]
        [MinCooldownMs:20000]
        [MaxCooldownMs:20001]
        [StartsReady:false]
        [MaxActions:-1]
        [Actions:AC-GIRR-MRC07-Launch-Screen]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-GIRR-MRC07-Launch-Screen</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]
        [SpawnEncounter:true]
        [Spawner:SP-GIRR-MRC07-Launch-Screen]
        [UseChatBroadcast:true]
        [ChatData:CH-GIRR-MRC07-Relaunch]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>SP-GIRR-MRC07-Launch-Screen</SubtypeId>
      </Id>
      <Description>

        [RivalAI Spawn]
        [UseSpawn:true]
        [SpawningType:CustomSpawn]
        [StartsReady:true]
        [SpawnMinCooldown:1]
        [SpawnMaxCooldown:2]
        [MaxSpawns:-1]
        [SpawnGroups:(NPC-GIRR) MRC07 Screen Wing]
        [UseRelativeSpawnPosition:false]
        [MinDistance:800]
        [MaxDistance:1500]
        [IgnoreSafetyChecks:false]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-GIRR-MRC07-Check-Screen</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:false]
        [Type:Timer]
        [MinCooldownMs:8000]
        [MaxCooldownMs:8001]
        [StartsReady:false]
        [MaxActions:-1]
        [Actions:AC-GIRR-MRC07-Check-Screen]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
