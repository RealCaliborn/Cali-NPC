    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CO-GIRR-MRC07-Check-Breaker2</SubtypeId>
      </Id>
      <Description>

        [RivalAI Command]
        [CommandCode:CO-GIRR-MRC07-Check-Breaker2]
        [MatchSenderReceiverOwners:true]
        [IgnoreAntennaRequirement:true]
        [Radius:10000]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-GIRR-MRC07-Receive-Breaker2</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:true]
        [Type:CommandReceived]
        [MinCooldownMs:0]
        [MaxCooldownMs:1]
        [StartsReady:true]
        [MaxActions:-1]
        [CommandReceiveCode:CO-GIRR-MRC07-Alive-Breaker2]
        [Actions:AC-GIRR-MRC07-Receive-Breaker2]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-GIRR-MRC07-Receive-Breaker2</SubtypeId>
      </Id>
      <Description>

