<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <!-- BH-PRTH-Cargo-Solo is used for Cargo ships that do not spawn reinforcements -->
    

<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-PRTH-Cargo-Solo-Bulk</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:HorseFighter]
        [AutopilotData:AP-Common-Default-A]
        [SecondaryAutopilotData:AP-Common-Standoff-1500-2250-B]
        [HorseFighterTimeEngaging:40]
        [HorseFighterTimeApproaching:22]
        [TargetData:TA-Common-Default-A]
        [OverrideTargetData:TA-Common-Default-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [UseTurrets:true]
        [TriggerGroups:TG-Common-Jump]
        [TriggerGroups:TG-PRTH-Cargo-Solo]
        [Triggers:TR-PRTH-FireFixed-Cargo]
        [TriggerGroups:TG-PRTH-Target-Sharing]
        [TriggerGroups:TG-PRTH-Reputation]
        [Triggers:TR-Common-Compromised-Stop]

      </Description>
    </EntityComponent>

<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-PRTH-Cargo-Solo-Hauler</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:Horsefly]
        [AutopilotData:AP-Common-Default-A]
        [SecondaryAutopilotData:AP-Common-Brawler-Default-B]
        [TargetData:TA-Common-Default-A]
        [OverrideTargetData:TA-Common-Default-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [UseTurrets:true]
        [TriggerGroups:TG-PRTH-Cargo-Solo]
        [Triggers:TR-PRTH-FireFixed-Cargo]
        [TriggerGroups:TG-PRTH-Target-Sharing]
        [TriggerGroups:TG-PRTH-Reputation]
        [Triggers:TR-Common-Compromised-Stop]

      </Description>
    </EntityComponent>

