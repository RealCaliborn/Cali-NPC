<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-PRTH-Trident</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:HorseFighter]
        [WeaponSystem:WS-Common-Baseline-Standard]
        [AutopilotData:AP-Common-Standoff-1500-2250-B]
        [TargetData:TA-Common-8000-A]
        [OverrideTargetData:TA-Common-Default-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [RemoteControlCode:SI-Roaches-Boss-Any]
        [TriggerGroups:TG-Common-PvE-Hard]
        [TriggerGroups:TG-PRTH-Trident]
        [TriggerGroups:TG-PRTH-Target-Sharing]
        [TriggerGroups:TG-ECHO-PRTH-Mayday-Responder]
        [TriggerGroups:TG-Common-Jump]
        [Triggers:TR-PRTH-Any-Engaging]


      </Description>
    </EntityComponent>

    <!-- ============================================================ -->
    <!-- Maintained shield-breaker #1: (NPC-PRTH) Speartip           -->
    <!-- Paladin Cannon (7x vs shields + ~2% shield bypass)          -->
    <!-- ============================================================ -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-PRTH-Trident-Breaker-Speartip</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:HorseFighter]
        [WeaponSystem:WS-Common-Baseline-Standard]
        [AutopilotData:AP-Common-Brawler-Close-B]
        [HorseFighterTimeEngaging:50]
        [HorseFighterTimeApproaching:12]
        [TargetData:TA-Common-Default-A]
        [OverrideTargetData:TA-Common-Default-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [TriggerGroups:TG-Common-PvE-Default]
        [TriggerGroups:TG-PRTH-Target-Sharing]
        [TriggerGroups:TG-ECHO-PRTH-Mayday-Responder]
        [TriggerGroups:TG-Common-Jump]
        [Triggers:TR-PRTH-Any-Engaging]
        [Triggers:TR-PRTH-Trident-Breaker1-Answer]
        [Triggers:TR-PRTH-Trident-Breaker1-SpawnCall]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-PRTH-Trident-Breaker1-Answer</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:true]
        [Type:CommandReceived]
        [MinCooldownMs:0]
        [MaxCooldownMs:1]
        [StartsReady:true]
        [MaxActions:-1]
        [CommandReceiveCode:CO-PRTH-Trident-Check-Breaker1]
        [Actions:AC-PRTH-Trident-Breaker1-Answer]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-PRTH-Trident-Breaker1-Answer</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]
        [BroadcastCommandProfiles:true]
        [CommandProfileIds:CO-PRTH-Trident-Alive-Breaker1]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CO-PRTH-Trident-Alive-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Command]
        [CommandCode:CO-PRTH-Trident-Alive-Breaker1]
        [MatchSenderReceiverOwners:true]
        [IgnoreAntennaRequirement:true]
        [Radius:12000]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-PRTH-Trident-Breaker1-SpawnCall</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:true]
        [Type:Timer]
        [MinCooldownMs:1500]
        [MaxCooldownMs:2500]
        [StartsReady:true]
        [MaxActions:1]
        [Actions:AC-PRTH-Trident-Breaker1-SpawnCall]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-PRTH-Trident-Breaker1-SpawnCall</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]
        [UseChatBroadcast:true]
        [ChatData:CH-PRTH-Trident-Breaker1-SpawnCall]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CH-PRTH-Trident-Breaker1-SpawnCall</SubtypeId>
      </Id>
      <Description>

        [RivalAI Chat]
        [UseChat:true]
        [StartsReady:true]
        [MaxChats:1]
        [BroadcastRandomly:false]
        [Author:Speartip]
        [Color:Red]
        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:10000]
        [ChatMessages:Speartip answering the call — breaking your shields.]
        [ChatAudio:prth-whoosh-01]
        [BroadcastChatType:Chat]
        [ChatVolumeMultiplier:0.35]

      </Description>
    </EntityComponent>

