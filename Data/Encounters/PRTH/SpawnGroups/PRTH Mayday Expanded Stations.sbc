  <SpawnGroups>
    <SpawnGroup>
      <Id>
        <TypeId>SpawnGroupDefinition</TypeId>
        <SubtypeId>(NPC-PRTH) Zenith Trade Hub Mayday VOID Easy Expanded (OUTER;INNER)</SubtypeId>
      </Id>
      <Description>
        [Modular Encounters SpawnGroup]
        [SpaceRandomEncounter:true]
        [FactionOwner:PRTH]
        [ReplenishSystems:true]
        [IgnoreShieldProviderMod:false]
        [ForceStaticGrid:true]
        [UseRivalAi:true]
        [RivalAiReplaceRemoteControl:true]
        [UseThreatLevelCheck:false]
        [ThreatLevelCheckRange:10000]
        [UseRemoteControlCodeRestrictions:true]
        [RemoteControlCode:Cali-Mayday-Controller]
        [RemoteControlCodeMinDistance:30000]
        [ThreatScoreMinimum:500]
        [ThreatScoreMaximum:1999]
        [AddDefenseShieldBlocks:true]
        [ReplaceArmorBlocksWithModules:true]
        [UseContainerTypeAssignment:true]
        [ContainerTypeAssignmentReference:Large Cargo Container|PRTH Store Default,Small Cargo Container|PRTH Store Default]
        [InitializeStoreBlocks:true]
        [ContainerTypesForStoreOrders:ECHO Cargo Ship Default]
        [ManipulationProfiles:MES-Manipulation-PropulsionPRTH]
      </Description>
      <IsPirate>true</IsPirate>
      <Frequency>0.7</Frequency>
      <Prefabs>
        <Prefab SubtypeId="(NPC-PRTH) Zenith Trade Hub">
          <Position>
            <X>0.0</X>
            <Y>0.0</Y>
            <Z>0.0</Z>
          </Position>
          <Speed>25</Speed>
          <Behaviour>BH-PRTH-Station-Mayday-VOID-Easy-Expanded</Behaviour>
        </Prefab>
      </Prefabs>
    </SpawnGroup>
