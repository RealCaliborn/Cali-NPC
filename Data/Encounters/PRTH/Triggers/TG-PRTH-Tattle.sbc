<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CH-PRTH-Tattle</SubtypeId>
      </Id>
      <Description>

        [RivalAI Chat]
        [UseChat:true]
        [StartsReady:true]
        [Author:{GridName}]
        [Color:CornflowerBlue]
        [Chance:100]
        [MaxChats:1]
        [BroadcastRandomly:true]
        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:15000]
        [ChatMessages:Hostile aggression logged. Requesting capital support - you are finished.]
        [BroadcastChatType:Chat]
        [ChatMessages:You should not have fired on us. The flagship is inbound.]
        [BroadcastChatType:Chat]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>SP-PRTH-Tattle</SubtypeId>
      </Id>
      <Description>

        [RivalAI Spawn]
        [UseSpawn:true]
        [SpawningType:CustomSpawn]
        [SpawnMinCooldown:0]
        [SpawnMaxCooldown:0]
        [MaxSpawns:1]
        [SpawnGroups:(NPC-PRTH) 1xTrident1xHoplon1xThunderbolt]
        [UseRelativeSpawnPosition:false]
        [MinDistance:900]
        [MaxDistance:1600]
        [IgnoreSafetyChecks:false]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-PRTH-Tattle</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]
        [Chance:10]
        [SpawnEncounter:true]
        [Spawner:SP-PRTH-Tattle]
        [UseChatBroadcast:true]
        [ChatData:CH-PRTH-Tattle]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-PRTH-Tattle</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:true]
        [Type:Damage]
        [DamageTypes:Any]
        [StartsReady:true]
        [MaxActions:1]
        [MinCooldownMs:1000]
        [MaxCooldownMs:2000]
        [Actions:AC-PRTH-Tattle]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TG-PRTH-Tattle</SubtypeId>
      </Id>
      <Description>

        [RivalAI TriggerGroup]
        [Triggers:TR-PRTH-Tattle]

      </Description>
    </EntityComponent>

  </EntityComponents>
</Definitions>
