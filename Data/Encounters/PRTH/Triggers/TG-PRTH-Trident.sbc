    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>SP-PRTH-Trident-Launch-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Spawn]
        [UseSpawn:true]
        [SpawningType:CustomSpawn]
        [StartsReady:true]
        [SpawnMinCooldown:1]
        [SpawnMaxCooldown:2]
        [MaxSpawns:-1]
        [SpawnGroups:(NPC-PRTH) Trident Breaker Speartip]
        [UseRelativeSpawnPosition:true]
        [RelativeSpawnOffset:{X:-40 Y:20 Z:30}]
        [RelativeSpawnVelocity:{X:0 Y:45 Z:0}]
        [IgnoreSafetyChecks:true]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CH-PRTH-Trident-Launch-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Chat]
        [UseChat:true]
        [StartsReady:true]
        [Author:Trident]
        [Color:Red]
        [Chance:100]
        [MaxChats:-1]
        [BroadcastRandomly:false]
        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:10000]
        [ChatMessages:Speartip escort down. Deploying another.]
        [BroadcastChatType:Chat]
        [ChatAudio:None]

      </Description>
    </EntityComponent>

