<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TG-PRTH-Trident</SubtypeId>
      </Id>
      <Description>

        [RivalAI TriggerGroup]

        [Triggers:TR-PRTH-Trident-Engaging]
        [Triggers:TR-PRTH-Trident-Activate]

        [Triggers:TR-PRTH-Trident-Launch-Breaker1]
        [Triggers:TR-PRTH-Trident-Check-Breaker1]
        [Triggers:TR-PRTH-Trident-Receive-Breaker1]

        [Triggers:TR-PRTH-Trident-Launch-Breaker2]
        [Triggers:TR-PRTH-Trident-Check-Breaker2]
        [Triggers:TR-PRTH-Trident-Receive-Breaker2]

        [Triggers:TR-PRTH-Trident-Launch-Screen]
        [Triggers:TR-PRTH-Trident-Check-Screen]
        [Triggers:TR-PRTH-Trident-Receive-Screen]

        [Triggers:TR-PRTH-Trident-Launch-Breaker3]
        [Triggers:TR-PRTH-Trident-Check-Breaker3]
        [Triggers:TR-PRTH-Trident-Receive-Breaker3]

        [Triggers:TR-PRTH-Trident-ShieldsDown-Spawn]

      </Description>
    </EntityComponent>

    <!-- =============================== Engaging bark =============================== -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-PRTH-Trident-Engaging</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]

        [UseTrigger:true]
        [Type:AcquiredTarget]
        [MinCooldownMs:120000]
        [MaxCooldownMs:120001]
        [StartsReady:true]
        [MaxActions:-1]
        [Actions:AC-PRTH-Trident-Engaging]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-PRTH-Trident-Engaging</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]

        [UseChatBroadcast:true]
        [ChatData:CH-PRTH-Trident-Engaging]

        [DisableTriggers:true]
        [DisableTriggerNames:TR-PRTH-Trident-Engaging]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CH-PRTH-Trident-Engaging</SubtypeId>
      </Id>
      <Description>

        [RivalAI Chat]

        [UseChat:true]
        [StartsReady:true]
        [Author:Trident]
        [Color:Red]

        [Chance:100]
        [MaxChats:1]
        [BroadcastRandomly:true]

        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:10000]

        [ChatMessages:I AM the wrath!]
        [BroadcastChatType:Chat]
        [ChatMessages:Your judgement has come, mortal.]
        [BroadcastChatType:Chat]
        [ChatMessages:This is where you meet your end, do not be a coward.]
        [BroadcastChatType:Chat]

      </Description>
    </EntityComponent>

    <!-- =============================== Activate (arms all 3 loops) =============================== -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-PRTH-Trident-Activate</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]

        [UseTrigger:true]
        [Type:PlayerNear]
        [TargetDistance:2000]
        [MinCooldownMs:1000]
        [MaxCooldownMs:2000]
        [StartsReady:true]
        [MaxActions:1]
        [Actions:AC-PRTH-Trident-Activate]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-PRTH-Trident-Activate</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]

        [ResetCooldownTimeOfTriggers:true]
        [ResetTriggerCooldownNames:TR-PRTH-Trident-Check-Breaker1]
        [ResetTriggerCooldownNames:TR-PRTH-Trident-Check-Breaker2]
        [ResetTriggerCooldownNames:TR-PRTH-Trident-Check-Screen]
        [ResetTriggerCooldownNames:TR-PRTH-Trident-Check-Breaker3]

        [EnableTriggers:true]
        [EnableTriggerNames:TR-PRTH-Trident-Launch-Breaker1]
        [EnableTriggerNames:TR-PRTH-Trident-Check-Breaker1]
        [EnableTriggerNames:TR-PRTH-Trident-Launch-Breaker2]
        [EnableTriggerNames:TR-PRTH-Trident-Check-Breaker2]
        [EnableTriggerNames:TR-PRTH-Trident-Launch-Screen]
        [EnableTriggerNames:TR-PRTH-Trident-Check-Screen]
        [EnableTriggerNames:TR-PRTH-Trident-Launch-Breaker3]
        [EnableTriggerNames:TR-PRTH-Trident-Check-Breaker3]

        [DisableTriggers:true]
        [DisableTriggerNames:TR-PRTH-Trident-Activate]

      </Description>
    </EntityComponent>

    <!-- ############################################################ -->
    <!-- LOOP 1 — shield-breaker #1: (NPC-PRTH) Speartip              -->
    <!-- ############################################################ -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-PRTH-Trident-Launch-Breaker1</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:false]
        [Type:Timer]
        [MinCooldownMs:14000]
        [MaxCooldownMs:14001]
        [StartsReady:false]
        [MaxActions:-1]
