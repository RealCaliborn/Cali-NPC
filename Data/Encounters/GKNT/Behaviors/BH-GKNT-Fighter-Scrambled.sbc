<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <!-- Non-broadcasting variant for Squadron Scramble / cross-faction reinforcement waves.
         Deliberately carries no TG-GKNT-Scramble (that lives only on BH-GKNT-Protected-Patrol)
         so spawned reinforcements cannot themselves call further reinforcements. -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-GKNT-Fighter-Scrambled-Saber</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:HorseFighter]
        [UseStaticGuns:true]
        [MaxStaticWeaponRange:-1]
        [Triggers:TR-Common-FireFixed]
        [UseAmmoReplenish:true]
        [AutopilotData:AP-Common-Brawler-Default-B]
        [HorseFighterTimeEngaging:23]
        [HorseFighterTimeApproaching:12]
        [TargetData:TA-GKNT-NPC-Protection-A]
        [OverrideTargetData:TA-GKNT-NPC-Protection-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [UseTurrets:true]
        [UseBarrageFire:false]
        [TriggerGroups:TG-Common-PvE-Default]
        [TriggerGroups:TG-GKNT-Target-Sharing]
        [TriggerGroups:TG-GKNT-Reputation]
        [TriggerGroups:TG-GKNT-Patrol-Chat]

      </Description>
    </EntityComponent>

<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-GKNT-Fighter-Scrambled-Swallow</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:Strike]
        [Triggers:TR-Common-FireFixed]
        [UseAmmoReplenish:true]
        [AutopilotData:AP-Common-Strike-Default-A]
        [StrikeBeginSpaceAttackRunDistance:3500]
        [StrikeBeginPlanetAttackRunDistance:2500]
        [StrikeBreakawayDistance:400]
        [StrikeOffsetRecalculationTime:8]
        [StrikeEngageUseSafePlanetPathing:true]
        [TargetData:TA-GKNT-NPC-Protection-A]
        [OverrideTargetData:TA-GKNT-NPC-Protection-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [UseStaticGuns:true]
        [MaxStaticWeaponRange:-1]
        [UseBarrageFire:false]
        [TriggerGroups:TG-Common-PvE-Default]
        [TriggerGroups:TG-GKNT-Target-Sharing]
        [TriggerGroups:TG-GKNT-Reputation]
        [TriggerGroups:TG-GKNT-Patrol-Chat]
        [TriggerGroups:TG-PRTH-ECHO-Mayday-Responder]
        [TriggerGroups:TG-PRTH-BASS-Mayday-Responder]

      </Description>
    </EntityComponent>

  </EntityComponents>
</Definitions>
