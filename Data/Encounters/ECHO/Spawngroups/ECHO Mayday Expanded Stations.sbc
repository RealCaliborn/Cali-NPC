<?xml version='1.0' encoding='utf-8'?>
<Definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <SpawnGroups>
    <SpawnGroup>
      <Id>
        <TypeId>SpawnGroupDefinition</TypeId>
        <SubtypeId>(NPC-ECHO) Mandir Mayday VOID Easy Expanded (OUTER;INNER)</SubtypeId>
      </Id>
      <Description>
        [Modular Encounters SpawnGroup]
        [SpaceRandomEncounter:true]
        [FactionOwner:ECHO]
        [ReplenishSystems:true]
        [IgnoreShieldProviderMod:false]
        [ForceStaticGrid:true]
        [UseRivalAi:true]
        [RivalAiReplaceRemoteControl:true]
        [UseThreatLevelCheck:false]
        [ThreatLevelCheckRange:10000]
        [UseRemoteControlCodeRestrictions:true]
        [RemoteControlCode:Cali-Mayday-Controller]
        [RemoteControlCodeMinDistance:30000]
        [ThreatScoreMinimum:500]
        [ThreatScoreMaximum:1999]
        [AddDefenseShieldBlocks:true]
        [ReplaceArmorBlocksWithModules:true]
        [UseContainerTypeAssignment:true]
        [ContainerTypeAssignmentReference:Large Cargo Container|ECHO Store Default,Small Cargo Container|ECHO Store Default]
        [InitializeStoreBlocks:true]
        [ContainerTypesForStoreOrders:PRTH Cargo Ship Default]
        [ManipulationProfiles:MES-Manipulation-PropulsionECHO]
      </Description>
      <IsPirate>true</IsPirate>
      <Frequency>0.7</Frequency>
      <Prefabs>
        <Prefab SubtypeId="(NPC-ECHO) Mandir">
          <Position>
            <X>0.0</X>
            <Y>0.0</Y>
            <Z>0.0</Z>
          </Position>
          <Speed>25</Speed>
          <Behaviour>BH-ECHO-Station-Mayday-VOID-Easy-Expanded</Behaviour>
        </Prefab>
      </Prefabs>
    </SpawnGroup>
