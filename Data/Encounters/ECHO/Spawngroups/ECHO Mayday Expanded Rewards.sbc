      <Prefabs>
        <Prefab SubtypeId="(NPC-All) SI Loot Pod">
          <Position>
            <X>0.0</X>
            <Y>0.0</Y>
            <Z>0.0</Z>
          </Position>
          <Speed>400</Speed>
          <Behaviour>BH-Common-None</Behaviour>
        </Prefab>
      </Prefabs>
    </SpawnGroup>
