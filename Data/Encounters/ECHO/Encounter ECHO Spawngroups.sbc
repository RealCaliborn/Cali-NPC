<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <SpawnGroups>
      <!-- (NPC-ECHO) Scarab -->
      <SpawnGroup>
        <Id>
            <TypeId>SpawnGroupDefinition</TypeId>
            <SubtypeId>(NPC-ECHO) Scarab (Easy)</SubtypeId>
        </Id>
        <Description>

        [Modular Encounters SpawnGroup]
    
        [DisableDampeners:false]

        [SpaceCargoShip:true]

        [FactionOwner:ECHO]
        [ReplenishSystems:true]

        [UseRivalAi:true]
        [RivalAiReplaceRemoteControl:true]

        [UseThreatLevelCheck:false]
        [ThreatLevelCheckRange:10000]
        [ThreatScoreMinimum:-1]
        [ThreatScoreMaximum:1000]

        [AssignContainerTypesToAllCargo:ECHO Cargo Easy]

        [UseContainerTypeAssignment:true]
        [ContainerTypeAssignmentReference:Large Cargo Container|ECHO Cargo Easy,Small Cargo Container|ECHO Cargo Easy,Lockers|ECHO Personal,Lockers 3|ECHO Personal,Lockers 4|ECHO Personal,Weapon Rack|ECHO Armory,Armory Lockers|ECHO Armory,Armory Lockers 2|ECHO Armory]
        [AddDefenseShieldBlocks:true]
        [ReplaceArmorBlocksWithModules:true]
        [ManipulationProfiles:MES-Manipulation-PropulsionECHO]

        </Description>
        <IsPirate>true</IsPirate>
        <Frequency>1.0</Frequency>
        <Prefabs>
          <Prefab SubtypeId="(NPC-ECHO) Scarab">
              <Position>
                  <X>0.0</X>
                  <Y>0.0</Y>
                  <Z>0.0</Z>
              </Position>
              <Speed>25</Speed>
              <Behaviour>BH-ECHO-Scarab-Single</Behaviour>
          </Prefab>
        </Prefabs>
    </SpawnGroup>
    <!-- (NPC-ECHO) Scarab -->

