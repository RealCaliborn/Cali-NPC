      </Id>
      <Description>

        [RivalAI Command]
        [CommandCode:CO-VOID-ThunderKraken-Carrier-Alive-Port]
        [MatchSenderReceiverOwners:true]
        [IgnoreAntennaRequirement:true]
        [Radius:10000]

      </Description>
    </EntityComponent>
