    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>AC-VOID-Stingray-2xBaby</SubtypeId>
      </Id>
      <Description>

      [RivalAI Action]
      
      [UseChatBroadcast:true]
      [ChatData:CH-VOID-CallSupport]

      [SpawnEncounter:true]
      [Spawner:SP-VOID-Spawn-2xStingbaby]

