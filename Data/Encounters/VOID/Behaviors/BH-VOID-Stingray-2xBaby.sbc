    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
          <TypeId>Inventory</TypeId>
          <SubtypeId>TR-VOID-Stingray-2xBaby</SubtypeId>
      </Id>
      <Description>

      [RivalAI Trigger]
      [Type:PlayerNear]
      [StartsReady:true]
      [UseTrigger:true]
      [MaxActions:3]
      [MinCooldownMs:30000]
      [MaxCooldownMs:60000]
