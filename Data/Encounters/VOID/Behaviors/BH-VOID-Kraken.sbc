<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-VOID-Kraken</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:HorseFighter]
        [WeaponSystem:WS-Common-Baseline-Standard]
        [AutopilotData:AP-Common-Standoff-1500-2250-B]
        [TargetData:TA-Common-Default-A]
        [OverrideTargetData:TA-Common-Default-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [RemoteControlCode:SI-Roaches-Boss-Any]
        [TriggerGroups:TG-Common-PvE-Hard]
        [TriggerGroups:TG-VOID-Target-Sharing]
        [Triggers:TR-VOID-ScreamBroadcast]
        [TriggerGroups:TG-VOID-Kraken]
        [TriggerGroups:TG-VOID-Reputation]
        [TriggerGroups:TG-Common-Escalate]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-VOID-Kraken-StingBaby-Port</SubtypeId>
      </Id>
      <Description>
        [RivalAI Behavior]
        [BehaviorName:HorseFighter]
        [WeaponSystem:WS-Common-Baseline-Standard]
        [AutopilotData:AP-Common-Brawler-Close-B]
        [HorseFighterTimeEngaging:50]
        [HorseFighterTimeApproaching:12]
        [TargetData:TA-Common-Default-A]
        [OverrideTargetData:TA-Common-Default-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [TriggerGroups:TG-Common-PvE-Default]
        [TriggerGroups:TG-VOID-Target-Sharing]
        [TriggerGroups:TG-VOID-Reputation]
        [TriggerGroups:TG-PRTH-VOID-Mayday-Responder]
        [TriggerGroups:TG-ECHO-VOID-Mayday-Responder]
        [Triggers:TR-VOID-Answer-Kraken-Port]
        [Triggers:TR-VOID-Kraken-Wing-SpawnCall-Port]
        [Triggers:TR-VOID-ScreamBroadcast]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
