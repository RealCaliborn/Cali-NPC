        [TriggerGroups:TG-PRTH-VOID-Mayday-Responder]
        [TriggerGroups:TG-ECHO-VOID-Mayday-Responder]
        [TriggerGroups:TG-Common-Jump]
        [Triggers:TR-VOID-Answer-Kraken-Starboard]
        [Triggers:TR-VOID-Kraken-Wing-SpawnCall-Starboard]
        [Triggers:TR-VOID-ScreamBroadcast]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>BH-VOID-Kraken-StingBro-Screen</SubtypeId>
      </Id>
      <Description>

        [RivalAI Behavior]
        [BehaviorName:HorseFighter]
        [WeaponSystem:WS-Common-Baseline-Standard]
        [AutopilotData:AP-Common-Standoff-1500-2000-B]
        [TargetData:TA-Common-Default-A]
        [OverrideTargetData:TA-Common-Default-B]
        [EngageOnTargetLineOfSight:true]
        [EngageOnWeaponActivation:true]
        [TriggerGroups:TG-Common-PvE-Default]
        [TriggerGroups:TG-VOID-Target-Sharing]
        [TriggerGroups:TG-VOID-Reputation]
        [TriggerGroups:TG-PRTH-VOID-Mayday-Responder]
        [TriggerGroups:TG-ECHO-VOID-Mayday-Responder]
        [TriggerGroups:TG-Common-Evade-Roll]
        [Triggers:TR-VOID-Answer-Kraken-Screen]
        [Triggers:TR-VOID-Kraken-Wing-SpawnCall-Screen]
        [Triggers:TR-VOID-ScreamBroadcast]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-VOID-Kraken-Wing-SpawnCall-Port</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]
        [UseTrigger:true]
        [Type:Timer]
        [MinCooldownMs:1500]
        [MaxCooldownMs:2500]
        [StartsReady:true]
        [MaxActions:1]
        [Actions:AC-VOID-Kraken-Wing-SpawnCall-Port]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-VOID-Kraken-Wing-SpawnCall-Port</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]
        [UseChatBroadcast:true]
        [ChatData:CH-VOID-Kraken-Wing-SpawnCall-Port]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CH-VOID-Kraken-Wing-SpawnCall-Port</SubtypeId>
      </Id>
      <Description>

        [RivalAI Chat]
        [UseChat:true]
        [StartsReady:true]
        [MaxChats:1]
        [BroadcastRandomly:false]
        [Author:VOID Lamprey]
        [Color:Red]
        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:10000]
        [ChatMessages:Lamprey answering the call — closing to break your shields.]
        [ChatAudio:Void-Screams]
        [BroadcastChatType:Chat]
        [ChatVolumeMultiplier:0.35]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
