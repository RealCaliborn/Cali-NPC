      <Description>

        [RivalAI Chat]
        [UseChat:true]
        [StartsReady:true]
        [MaxChats:1]
        [BroadcastRandomly:false]
        [Author:VOID Stingray]
        [Color:Red]
        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:10000]
        [ChatMessages:Stingray inbound — railguns and beams hot.]
        [ChatAudio:Void-Screams]
        [BroadcastChatType:Chat]
        [ChatVolumeMultiplier:0.35]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
