			<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
				<SubtypeId>(NPC-VOID)1xKraken1xUrchinS1xUrchinB</SubtypeId>
			</Id>
			<Description>

			[Modular Encounters SpawnGroup]

            [DisableDampeners:false]

            [SpaceCargoShip:true]
            [SpaceRandomEncounter:true]

            [FactionOwner:VOID]
            [ReplenishSystems:true]
            [GridsAreEditable:true]
            [GridsAreDestructable:true]
            [UseRivalAi:true]
            [RivalAiReplaceRemoteControl:true]
            [RotateFirstCockpitToForward:true]
            [AddDefenseShieldBlocks:true]

            [UseThreatLevelCheck:false]
            [ThreatLevelCheckRange:10000]
            [ThreatScoreMinimum:2500]
            [ThreatScoreMaximum:-1]

			[UseRemoteControlCodeRestrictions:true]
			[RemoteControlCode:SI-Roaches-Boss-Any]
			[RemoteControlCodeMinDistance:20000]
            [ReplaceArmorBlocksWithModules:true]
            [ModulesForArmorReplacement:MyObjectBuilder_RadioAntenna/MES-Suppressor-Jetpack-Large]
			[ManipulationProfiles:MES-Manipulation-PropulsionVOID]
			
      [AssignContainerTypesToAllCargo:VOID Cargo Hard]
			
      [UseContainerTypeAssignment:true]
      [ContainerTypeAssignmentReference:Enhanced Medium Quantum Container|VOID Cargo Hard,Enhanced Medium Quantum Container 2|VOID Cargo Hard,Large Cargo Container|VOID Cargo Hard,Medium Cargo Container|VOID Cargo Hard,Medium Cargo Container 2|VOID Cargo Hard,Medium Cargo Container 3|VOID Cargo Hard,Medium Cargo Container 4|VOID Cargo Hard,Small Cargo Container|VOID Cargo Hard,Lockers|VOID Personal,Lockers 2|VOID Personal,Lockers 3|VOID Personal,Lockers 4|VOID Personal,Lockers 5|VOID Personal,Lockers 6|VOID Personal,Lockers 7|VOID Personal,Armory|VOID Armory,Armory 10|VOID Armory,Armory 11|VOID Armory,Armory 12|VOID Armory,Armory 13|VOID Armory,Armory 14|VOID Armory,Armory 15|VOID Armory,Armory 16|VOID Armory,Armory 2|VOID Armory,Armory 3|VOID Armory,Armory 4|VOID Armory,Armory 5|VOID Armory,Armory 6|VOID Armory,Armory 7|VOID Armory,Armory 8|VOID Armory,Armory 9|VOID Armory,Armory Lockers|VOID Armory,Armory Lockers 2|VOID Armory,Armory Lockers 3|VOID Armory,Weapon Rack|VOID Armory,Reward Container|Cali Elite Reward]
      </Description>
			<IsPirate>true</IsPirate>
			<Frequency>1.0</Frequency>
			<Prefabs>
				<Prefab SubtypeId="(NPC-VOID) Urchin S">
					<Position>
						<X>0.0</X>
						<Y>500.5</Y>
						<Z>0.0</Z>
					</Position>
					<Speed>400</Speed>
