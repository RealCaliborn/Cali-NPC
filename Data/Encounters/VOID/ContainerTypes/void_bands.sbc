<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <ContainerTypes>

<!-- VOID band-scaled ship cargo. Theme: exotic / uranium / reactor / alien salvage.
     Assigned per encounter threat band (ENCOUNTER_THREAT_MAP.md):
       Easy (<0.05), Medium (0.05-0.149), Hard (>=0.15, non-elite). Backbone ids
     (+ GammaMeshRefractor/AryxLynxon fusion from bundle). First-cut, tune later. -->

<!-- VOID Cargo Easy -->
    <ContainerType CountMin="2" CountMax="3">
      <Id><TypeId>ContainerTypeDefinition</TypeId><SubtypeId>VOID Cargo Easy</SubtypeId></Id>
      <Items>
        <Item AmountMin="500" AmountMax="2500"><Frequency>5</Frequency><Id><TypeId>Ore</TypeId><SubtypeId>Uranium</SubtypeId></Id></Item>
        <Item AmountMin="500" AmountMax="2000"><Frequency>4</Frequency><Id><TypeId>Ore</TypeId><SubtypeId>Scrap</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Reactor</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech2x</SubtypeId></Id></Item>
        <Item AmountMin="5000" AmountMax="25000"><Frequency>2</Frequency><Id><TypeId>PhysicalObject</TypeId><SubtypeId>SpaceCredit</SubtypeId></Id></Item>
      </Items>
    </ContainerType>

<!-- VOID Cargo Medium -->
    <ContainerType CountMin="3" CountMax="4">
      <Id><TypeId>ContainerTypeDefinition</TypeId><SubtypeId>VOID Cargo Medium</SubtypeId></Id>
      <Items>
        <Item AmountMin="1000" AmountMax="3000"><Frequency>4</Frequency><Id><TypeId>Ore</TypeId><SubtypeId>Uranium</SubtypeId></Id></Item>
        <Item AmountMin="300" AmountMax="1200"><Frequency>3</Frequency><Id><TypeId>Ingot</TypeId><SubtypeId>Uranium</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="300"><Frequency>4</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Reactor</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="300"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Thrust</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Superconductor</SubtypeId></Id></Item>
        <Item AmountMin="25" AmountMax="200"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>AdaptiveDynoCapacitor</SubtypeId></Id></Item>
        <Item AmountMin="200" AmountMax="800"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech2x</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="400"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech4x</SubtypeId></Id></Item>
        <Item AmountMin="25000" AmountMax="100000"><Frequency>2</Frequency><Id><TypeId>PhysicalObject</TypeId><SubtypeId>SpaceCredit</SubtypeId></Id></Item>
      </Items>
    </ContainerType>

<!-- VOID Cargo Hard -->
    <ContainerType CountMin="3" CountMax="5">
      <Id><TypeId>ContainerTypeDefinition</TypeId><SubtypeId>VOID Cargo Hard</SubtypeId></Id>
      <Items>
        <Item AmountMin="2000" AmountMax="5000"><Frequency>4</Frequency><Id><TypeId>Ore</TypeId><SubtypeId>Uranium</SubtypeId></Id></Item>
        <Item AmountMin="500" AmountMax="2000"><Frequency>3</Frequency><Id><TypeId>Ingot</TypeId><SubtypeId>Uranium</SubtypeId></Id></Item>
        <Item AmountMin="200" AmountMax="600"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Reactor</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="400"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Thrust</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="300"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Superconductor</SubtypeId></Id></Item>
        <Item AmountMin="100" AmountMax="500"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>AdaptiveDynoCapacitor</SubtypeId></Id></Item>
        <Item AmountMin="25" AmountMax="100"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>GammaMeshRefractor</SubtypeId></Id></Item>
        <Item AmountMin="20" AmountMax="60"><Frequency>1</Frequency><Id><TypeId>Component</TypeId><SubtypeId>AryxLynxon_FusionComponent</SubtypeId></Id></Item>
        <Item AmountMin="400" AmountMax="1200"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech2x</SubtypeId></Id></Item>
        <Item AmountMin="200" AmountMax="600"><Frequency>3</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech4x</SubtypeId></Id></Item>
        <Item AmountMin="50" AmountMax="200"><Frequency>2</Frequency><Id><TypeId>Component</TypeId><SubtypeId>Tech8x</SubtypeId></Id></Item>
        <Item AmountMin="100000" AmountMax="300000"><Frequency>2</Frequency><Id><TypeId>PhysicalObject</TypeId><SubtypeId>SpaceCredit</SubtypeId></Id></Item>
      </Items>
    </ContainerType>

<!-- VOID Personal: Lockers / Locker Room. Nomadic raider crew kit. Backbone. -->
    <ContainerType CountMin="2" CountMax="4">
      <Id><TypeId>ContainerTypeDefinition</TypeId><SubtypeId>VOID Personal</SubtypeId></Id>
      <Items>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>AngleGrinder2Item</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>HandDrill2Item</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>Welder2Item</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>AutomaticRifleItem</SubtypeId></Id></Item>
        <Item AmountMin="4" AmountMax="12"><Frequency>4</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>AutomaticRifleGun_Mag_20rd</SubtypeId></Id></Item>
        <Item AmountMin="3" AmountMax="8"><Frequency>3</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>NATO_5p56x45mm</SubtypeId></Id></Item>
        <Item AmountMin="2" AmountMax="6"><Frequency>4</Frequency><Id><TypeId>ConsumableItem</TypeId><SubtypeId>Medkit</SubtypeId></Id></Item>
        <Item AmountMin="2" AmountMax="6"><Frequency>4</Frequency><Id><TypeId>ConsumableItem</TypeId><SubtypeId>Powerkit</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="4"><Frequency>2</Frequency><Id><TypeId>ConsumableItem</TypeId><SubtypeId>RadiationKit</SubtypeId></Id></Item>
        <Item AmountMin="2500" AmountMax="15000"><Frequency>3</Frequency><Id><TypeId>PhysicalObject</TypeId><SubtypeId>SpaceCredit</SubtypeId></Id></Item>
      </Items>
    </ContainerType>

<!-- VOID Armory: Armory / Weapon Rack. Weapons + ammo ONLY (theme). Backbone. -->
    <ContainerType CountMin="2" CountMax="4">
      <Id><TypeId>ContainerTypeDefinition</TypeId><SubtypeId>VOID Armory</SubtypeId></Id>
      <Items>
        <Item AmountMin="1" AmountMax="2"><Frequency>4</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>AutomaticRifleItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>RapidFireAutomaticRifleItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="1"><Frequency>2</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>PreciseAutomaticRifleItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>SemiAutoPistolItem</SubtypeId></Id></Item>
        <Item AmountMin="1" AmountMax="2"><Frequency>3</Frequency><Id><TypeId>PhysicalGunObject</TypeId><SubtypeId>FullAutoPistolItem</SubtypeId></Id></Item>
        <Item AmountMin="6" AmountMax="16"><Frequency>5</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>AutomaticRifleGun_Mag_20rd</SubtypeId></Id></Item>
        <Item AmountMin="6" AmountMax="16"><Frequency>4</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>NATO_5p56x45mm</SubtypeId></Id></Item>
        <Item AmountMin="4" AmountMax="12"><Frequency>4</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>RapidFireAutomaticRifleGun_Mag_50rd</SubtypeId></Id></Item>
        <Item AmountMin="4" AmountMax="12"><Frequency>4</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>SemiAutoPistolMagazine</SubtypeId></Id></Item>
        <Item AmountMin="4" AmountMax="12"><Frequency>3</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>FullAutoPistolMagazine</SubtypeId></Id></Item>
        <Item AmountMin="2" AmountMax="6"><Frequency>2</Frequency><Id><TypeId>AmmoMagazine</TypeId><SubtypeId>PreciseAutomaticRifleGun_Mag_5rd</SubtypeId></Id></Item>
      </Items>
    </ContainerType>

  </ContainerTypes>
</Definitions>
