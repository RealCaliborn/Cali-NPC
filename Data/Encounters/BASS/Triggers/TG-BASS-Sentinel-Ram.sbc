<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TG-BASS-Sentinel-Ram</SubtypeId>
      </Id>
      <Description>

        [RivalAI TriggerGroup]

        [Triggers:TR-BASS-Sentinel-Ram]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-BASS-Sentinel-Ram</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]

        [UseTrigger:true]
        [Type:Damage]
        [DamageTypes:Any]
        [StartsReady:true]
        [MaxActions:-1]
        [MinCooldownMs:10000]
        [MaxCooldownMs:20000]

        [Conditions:CD-Common-TargetAhead]

        [Actions:AC-BASS-Sentinel-Ram]

      </Description>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-BASS-Sentinel-Ram</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]

        [Chance:50]
        [Ramming:true]

      </Description>
    </EntityComponent>

  </EntityComponents>
</Definitions>
