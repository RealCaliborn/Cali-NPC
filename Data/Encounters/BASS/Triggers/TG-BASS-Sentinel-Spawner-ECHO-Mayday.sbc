<?xml version='1.0' encoding='utf-8'?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TG-BASS-Sentinel-Spawner-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

        [RivalAI TriggerGroup]

        [Triggers:TR-BASS-Sentinel-Spawner-ECHO-Mayday]
        [Triggers:TR-BASS-Distress-Stage2-ECHO-Mayday]
        [Triggers:TR-BASS-Distress-Stage3-ECHO-Mayday]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-BASS-Sentinel-Spawner-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]

        [UseTrigger:true]
        [Type:PlayerNear]
        [TargetDistance:3500]
        [MinCooldownMs:1000]
        [MaxCooldownMs:3000]
        [MaxActions:3]
        [EnableNamedTriggerOnSuccess:TR-BASS-Distress-Stage2-ECHO-Mayday]
        [Actions:AC-BASS-Sentinel-Spawner-ECHO-Mayday]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-BASS-Sentinel-Spawner-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]

        [Chance:60]

        [SpawnEncounter:true]
        [Spawner:SP-BASS-Sentinel-Spawner-ECHO-Mayday]

        [UseChatBroadcast:true]
        [ChatData:CH-BASS-Distress-Call-ECHO-Mayday]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CH-BASS-Distress-Call-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

        [RivalAI Chat]

        [UseChat:true]
        [StartsReady:true]
        [Author:{GridName}]
        [Color:Red]

        [Chance:80]
        [MaxChats:1]
        [BroadcastRandomly:true]

        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:10000]

        [ChatMessages:Distress signal relayed. Reinforcements inbound.]
        [ChatAudio:bass-alarm-01]
        [BroadcastChatType:Chat]
        [ChatMessages:Distress Network activated. Support requested.]
        [ChatAudio:bass-alarm-01]
        [BroadcastChatType:Chat]
        [ChatMessages:Serious threat confirmed. Sentinel assistance requested.]
        [ChatAudio:bass-alarm-01]
        [BroadcastChatType:Chat]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>SP-BASS-Sentinel-Spawner-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

      [RivalAI Spawn]
      
      [UseSpawn:true]
      
      [SpawningType:CustomSpawn]
      [StartsReady:true]
      [SpawnMinCooldown:1]
      [SpawnMaxCooldown:2]
      [MaxSpawns:3]
      
      [SpawnGroups:(NPC-BASS) Gx1]
      
      [UseRelativeSpawnPosition:false]
      [MinDistance:500]
      [MaxDistance:1200]
      [IgnoreSafetyChecks:false]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-BASS-Distress-Stage2-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]

        [UseTrigger:false]
        [Type:Damage]
        [DamageTypes:Any]
        [MinCooldownMs:1000]
        [MaxCooldownMs:2000]
        [StartsReady:true]
        [MaxActions:1]
        [EnableNamedTriggerOnSuccess:TR-BASS-Distress-Stage3-ECHO-Mayday]
        [Actions:AC-BASS-Distress-Stage2-ECHO-Mayday]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-BASS-Distress-Stage2-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]

        [SpawnEncounter:true]
        [Spawner:SP-BASS-Distress-Stage2-ECHO-Mayday]

        [UseChatBroadcast:true]
        [ChatData:CH-BASS-Distress-Escalate-ECHO-Mayday]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>CH-BASS-Distress-Escalate-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

        [RivalAI Chat]

        [UseChat:true]
        [StartsReady:true]
        [Author:{GridName}]
        [Color:Red]

        [Chance:100]
        [MaxChats:1]
        [BroadcastRandomly:true]

        [IgnoreAntennaRequirement:true]
        [IgnoredAntennaRangeOverride:10000]

        [ChatMessages:Distress escalation transmitted. Immediate reinforcement required.]
        [ChatAudio:bass-riser-01]
        [BroadcastChatType:Chat]
        [ChatMessages:Support response absent. Threat level elevated.]
        [ChatAudio:bass-riser-01]
        [BroadcastChatType:Chat]
        [ChatMessages:Containment failing. Distress Network priority increased.]
        [ChatAudio:bass-riser-01]
        [BroadcastChatType:Chat]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>SP-BASS-Distress-Stage2-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

      [RivalAI Spawn]

      [UseSpawn:true]

      [SpawningType:CustomSpawn]
      [StartsReady:true]
      [SpawnMinCooldown:1]
      [SpawnMaxCooldown:2]
      [MaxSpawns:1]

      [SpawnGroups:(NPC-BASS) Gx2]

      [UseRelativeSpawnPosition:false]
      [MinDistance:500]
      [MaxDistance:1200]
      [IgnoreSafetyChecks:false]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>TR-BASS-Distress-Stage3-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

        [RivalAI Trigger]

        [UseTrigger:false]
        [Type:Damage]
        [DamageTypes:Any]
        [MinCooldownMs:1000]
        [MaxCooldownMs:2000]
        [StartsReady:true]
        [MaxActions:1]
        [Actions:AC-BASS-Distress-Stage3-ECHO-Mayday]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>AC-BASS-Distress-Stage3-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

        [RivalAI Action]

        [SpawnEncounter:true]
        [Spawner:SP-BASS-Distress-Stage3-ECHO-Mayday]

      </Description>
    </EntityComponent>
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>SP-BASS-Distress-Stage3-ECHO-Mayday</SubtypeId>
      </Id>
      <Description>

      [RivalAI Spawn]

      [UseSpawn:true]

      [SpawningType:CustomSpawn]
      [StartsReady:true]
      [SpawnMinCooldown:1]
      [SpawnMaxCooldown:2]
      [MaxSpawns:1]

      [SpawnGroups:(NPC-BASS) Gx2]

      [UseRelativeSpawnPosition:false]
      [MinDistance:500]
      [MaxDistance:1200]
      [IgnoreSafetyChecks:false]

      </Description>
    </EntityComponent>
  </EntityComponents>
</Definitions>